{
  "name": "maleghast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && tsc --noEmit -p worker && vite build",
    "test": "vitest run",
    "worker": "wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "e2e": "node e2e/duel.mjs && node e2e/solo.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/three": "0.186.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
